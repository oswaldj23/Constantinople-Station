# Copy to .env and fill in. Everything is optional: with nothing set the engine runs in DRY_RUN
# and every tool returns realistic fake data so you can watch the station work end to end.

STATION_NAME=Constantinople Station   # shown on the HUD and boot screen; CALLSIGN defaults to the first word
CALLSIGN=CONSTANTINOPLE
MISSION_TARGET=1e12          # the Prime Mission, in USD
CREATOR=the Creator          # your name; Mother escalates to you by it
MOTHER_NAME=MOTHER
AUTONOMY=assist              # assist = spend/publish gates wait for you · full = Mother approves within the caps below
DAILY_SPEND_CAP=10           # USD/day Mother may approve on her own in full autonomy
MAX_RETRIES=3

DRY_RUN=true                 # false = real model calls + real marketplace calls (only where keys are set)
AUTO_APPROVE=false           # true = skip approval gates for spend/publish steps (not recommended at first)
HOST=127.0.0.1
PORT=8787
DB_PATH=constantinople.db
SPEED=1.0                    # >1 runs cadences faster (demo); 1.0 = real schedule

ANTHROPIC_API_KEY=           # agent steps (research, copy, replies). Empty = canned outputs.
AGENT_MODEL=claude-sonnet-4-5
IMAGE_PROVIDER=none          # none | openai | replicate — see constantinople/tools/images.py
IMAGE_API_KEY=

PRINTIFY_API_KEY=            # https://developers.printify.com
PRINTIFY_SHOP_ID=
ETSY_API_KEY=                # https://developers.etsy.com (OAuth 2 — see constantinople/tools/etsy.py)
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=

# ── Phone control (Telegram) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # from @BotFather; then send /start to your bot once
TELEGRAM_CHAT_ID=            # optional; bound automatically by /start
REPORT_HOUR=11               # local hour for Mother's daily report
TELEGRAM_VERBOSITY=quiet     # quiet = only what needs you or made money · normal = also incidents and waypoints
REPORT_UTC_OFFSET=-4         # New York: -4 in summer, -5 in winter

# ── Real Comms: the inbox where Etsy/Printify notification emails arrive ──
MAIL_IMAP_HOST=              # imap.gmail.com
MAIL_USER=                   # you@gmail.com
MAIL_PASSWORD=               # Gmail App Password (16 letters), not your normal password

# ── Treasury control loop ─────────────────────────────────────────────────
AUTO_RETIRE=false            # unpublish listings with zero sales after 30 days
AUTO_PRICE=false             # raise prices 10% on listings with 3+ sales
