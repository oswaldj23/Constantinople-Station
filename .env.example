# Copy to .env and fill in. Everything is optional: with nothing set the engine runs in DRY_RUN
# and every tool returns realistic fake data so you can watch the station work end to end.

STATION_NAME=Constantinople Station   # shown on the HUD and boot screen; CALLSIGN defaults to the first word
CALLSIGN=CONSTANTINOPLE
MISSION_TARGET=1e12          # the Prime Mission, in USD
CREATOR=the Creator          # your name; Mother escalates to you by it
MOTHER_NAME=MOTHER
AUTONOMY=assist              # assist = spend/publish gates wait for you · full = Mother approves within the caps below
DAILY_SPEND_CAP=10           # USD/day Mother may approve on her own in full autonomy
MAX_RETRIES=3

DRY_RUN=true                 # false = real model calls + real marketplace calls (only where keys are set)
AUTO_APPROVE=false           # true = skip approval gates for spend/publish steps (not recommended at first)
HOST=127.0.0.1
PORT=8787
DB_PATH=constantinople.db
SPEED=1.0                    # >1 runs cadences faster (demo); 1.0 = real schedule

ANTHROPIC_API_KEY=           # agent steps (research, copy, replies). Empty = canned outputs.
AGENT_MODEL=claude-sonnet-4-5      # the crew
MOTHER_MODEL=claude-opus-4-1       # Mother: strongest tier; she makes only a handful of calls a day
IMAGE_PROVIDER=none          # none | openai | replicate — see constantinople/tools/images.py
IMAGE_API_KEY=

PRINTIFY_API_KEY=            # https://developers.printify.com
PRINTIFY_SHOP_ID=
ETSY_API_KEY=                # https://developers.etsy.com (OAuth 2 — see constantinople/tools/etsy.py)
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=

# ── Phone control (Telegram) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # from @BotFather; then send /start to your bot once
TELEGRAM_CHAT_ID=            # optional; bound automatically by /start
REPORT_HOUR=11               # local hour for Mother's daily report
TELEGRAM_VERBOSITY=quiet     # quiet = only what needs you or made money · normal = also incidents and waypoints
REPORT_UTC_OFFSET=-4         # New York: -4 in summer, -5 in winter

# ── Real Comms: the inbox where Etsy/Printify notification emails arrive ──
MAIL_IMAP_HOST=              # imap.gmail.com
MAIL_USER=                   # you@gmail.com
MAIL_PASSWORD=               # Gmail App Password (16 letters), not your normal password

# ── Production volume ─────────────────────────────────────────────────────
LISTINGS_PER_DAY=2           # how many new Etsy listings a day (each ~$0.20 listing fee + ~$0.10 of images)
PRODUCT_ROTATION=tee,sweatshirt,mug,poster,tee,tote,hoodie   # product types, in the order the shop cycles through them
DESIGN_STYLES=               # empty = all styles (typo_saying, retro_varsity, retro_sunset, vintage_badge, groovy, script_quote, kawaii, line_minimal, watercolor, botanical, pet_humor)

# ── Treasury control loop ─────────────────────────────────────────────────
AUTO_RETIRE=false            # unpublish listings with zero sales after 30 days
AUTO_PRICE=false             # raise prices 10% on listings with 3+ sales

# ── Pinterest (free traffic for the shop) ─────────────────────────────────
PINTEREST_APP_ID=            # developers.pinterest.com → My apps; redirect URI http://localhost:3005/oauth/redirect
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=      # filled by: python -m constantinople pinterest-auth
PINTEREST_REFRESH_TOKEN=

# ── Adobe Stock contributor (passive royalties) ───────────────────────────
STOCK_SFTP_HOST=sftp.contributor.adobestock.com
STOCK_SFTP_USER=             # contributor.stock.adobe.com → Upload → "Connect via SFTP": your username
STOCK_SFTP_PASSWORD=         # the SFTP password you set there (not your Adobe login)
PUBLIC_URL=                  # how you open the dashboard, e.g. http://100.64.0.5:8787 — lets Mother send you download links

# ── Clip Forge (YouTube/TikTok shorts) + Signal Deck (what shorts are being watched) ──
TTS_VOICE=onyx               # voice for narration: alloy ash coral echo fable onyx nova sage shimmer (uses the IMAGE_API_KEY OpenAI key)
YOUTUBE_API_KEY=             # Google Cloud → YouTube Data API v3 → API key. Lets Signal Deck scan trends.
YOUTUBE_CLIENT_ID=           # Google Cloud → OAuth client (Desktop app). Lets Clip Forge upload.
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=       # filled by: python -m constantinople youtube-auth
YOUTUBE_CHANNEL=             # filled by youtube-auth
CLIP_PRICE=35                # what one made-to-order short sells for
CLIPS_PER_DAY=3              # shorts a day on our own channel (max ~5: YouTube's API quota)
TRANSCRIBE=local             # local = Whisper on the server (free; needs faster-whisper) · openai = Whisper API
WHISPER_MODEL=small          # tiny/base/small/medium — small is the sweet spot on 4 cores
SIGNAL_GENRES=scary stories,reddit stories,aita,story time,revenge stories,creepypasta,true scary stories,minecraft parkour,satisfying,facts,history,motivation,cozy aesthetic,ai art,etsy small business,day in the life
